+      public function legendaryWeaponMultiplier(skill:int) : Number
+      {
+         var ids:Array = ["","melee","smallguns","repair","energy","explosives","magic","tele"];
+         if(skill < 1 || skill > 7) return 1;
+         return 1 + 0.15 * Math.max(0,this.getWeapLevel(skill)-5);
+      }
+
+      public function legendaryParameters() : void
+      {
+         var teleRanks:int = Math.max(0,this.getSkillLevel("tele")-5);
+         if(teleRanks > 0) this.teleMult = 0.2 * Math.pow(0.9,teleRanks);
+         this.healMult *= 1 + 0.15 * Math.max(0,this.getSkillLevel("medic")-5);
+         this.repairMult *= 1 + 0.20 * Math.max(0,this.getSkillLevel("repair")-5);
+         this.lockPickTime = Math.max(6,Math.round(this.lockPickTime / (1 + 0.30 * Math.max(0,this.getSkillLevel("lockpick")-5)))) ;
